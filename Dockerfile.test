FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc make libc-dev wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN wget -q https://ftp.gnu.org/gnu/inetutils/inetutils-2.0.tar.gz && \
    tar xzf inetutils-2.0.tar.gz
WORKDIR /build/inetutils-2.0
RUN ./configure --enable-ping
RUN make -C lib && make -C libinetutils && make -C libicmp && make -C ping && make -C ping install

WORKDIR /build
COPY . .
RUN make

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends netbase \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/ping /usr/bin/ping
COPY --from=builder /build/ft_ping /usr/local/bin/ft_ping
COPY test-diff.sh /test-diff.sh
CMD ["/test-diff.sh"]
